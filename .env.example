# Copia este archivo como .env.local (no se sube a GitHub) y pon tu clave.
# En Vercel, crea las mismas variables en Settings → Environment Variables.

# Google Gemini (plan gratuito para los modelos Flash): https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.tu_clave_completa
# Opcional: modelos en orden de preferencia
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite

# Alternativa de pago: Perplexity (https://console.perplexity.ai)
# PERPLEXITY_API_KEY=pplx-...
# AI_PROVIDER=perplexity
